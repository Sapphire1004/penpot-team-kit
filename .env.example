COMPOSE_PROJECT_NAME=penpot-team-kit
PENPOT_VERSION=2.18.5
PENPOT_PUBLIC_URI=http://localhost:9001
PENPOT_BIND_ADDRESS=127.0.0.1
PENPOT_PORT=9001
PENPOT_SECRET_KEY=GENERATED_BY_PENPOT_INIT
PENPOT_DATABASE_PASSWORD=GENERATED_BY_PENPOT_INIT
PENPOT_FLAGS=disable-registration enable-login-with-password disable-email-verification disable-secure-session-cookies disable-smtp disable-log-emails disable-admin-console enable-mcp
LOCAL_UID=1000
LOCAL_GID=1000
